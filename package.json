{
  "name": "cabinetmaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser app for designing frameless/euro-style cabinetry: 2D elevation editor → live 3D → kerf-aware cut list → shopping list → assembly steps. Fully local, open-source.",
  "license": "MIT",
  "author": "Ernest Iliiasov",
  "homepage": "https://github.com/ernestii/cabinetmaker#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ernestii/cabinetmaker.git"
  },
  "bugs": {
    "url": "https://github.com/ernestii/cabinetmaker/issues"
  },
  "keywords": [
    "cabinetry",
    "woodworking",
    "cabinet-design",
    "cut-list",
    "frameless",
    "euro-style",
    "three.js",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mantine/core": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "@mantine/notifications": "^9.3.1",
    "@react-pdf/renderer": "^4.5.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tabler/icons-react": "^3.44.0",
    "immer": "^11.1.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
